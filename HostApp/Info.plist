<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>UDFViewer</string>
  <key>CFBundleIdentifier</key><string>com.uyapudf.viewer</string>
  <key>CFBundleName</key><string>UDFViewer</string>
  <key>CFBundleDisplayName</key><string>UDF Görüntüleyici</string>
  <key>CFBundleIconFile</key><string>UDFViewer.icns</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <!--
    BİLİNÇLİ OLARAK CFBundleDocumentTypes YOK.
    Bu yalnızca QuickLook (önizleme + thumbnail) sağlayan bir araçtır; kendisini
    .udf için bir "belge açıcı" olarak KAYDETMEZ. Aksi halde LaunchServices bu
    salt-okunur görüntüleyiciyi .udf'in açıcı listesine ekler ve resmî UYAP
    editörü (UDE) silindiğinde/çakıştığında çift tıklama editör yerine buraya
    yönlenir. Çift tıklama her zaman kullanıcının kendi editörüne gitmeli.
  -->
  <!--
    UTI'yi İTHAL (imported) ediyoruz, İHRAÇ (exported) DEĞİL. İthal: ".udf
    uzantısının bir UTI'si olduğunu sisteme bildiririm ama sahibi ben değilim."
    Bu sayede resmî editörün kendi türüyle (tr.gov.uyap.editor.udf) çakışmayız;
    yalnızca QuickLook eklentilerinin türü tanıyabilmesini sağlarız.
  -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeDescription</key><string>UYAP UDF Document</string>
      <key>UTTypeIdentifier</key><string>com.uyap.udf</string>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>udf</string></array></dict>
    </dict>
  </array>
</dict>
</plist>
